# agile-product-agent — project configuration
#
# Copy this file to the root of the project where you run the plugin, as `.env`,
# and fill in the values. This file lives in YOUR project, not in the plugin, so
# the defaults are per-project and survive plugin updates.
#
# All values are optional. In local fallback mode (no Atlassian MCP connected),
# the agent prompts once for any missing key and defaults to PROD / TEAM.

# Default Jira project key — also names the workspace/jira/ subfolder in local mode (e.g. MYPROJ)
DEFAULT_JIRA_PROJECT_KEY=

# Default Confluence space key — also names the workspace/confluence/ subfolder in local mode (e.g. TEAM)
DEFAULT_CONFLUENCE_SPACE_ID=

# Numeric Jira board ID for kanban / burndown (live mode only)
DEFAULT_JIRA_BOARD_ID=

# MCP tool name backing the email-read alias, used by /ingest email (no local fallback)
EMAIL_MCP_TOOL=
